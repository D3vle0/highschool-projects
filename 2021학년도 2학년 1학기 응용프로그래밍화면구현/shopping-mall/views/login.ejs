<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <title>Devleo Gaming</title>
</head>
<style>
    body {
        background: #ffd1fa;
        background: -moz-linear-gradient(-45deg, #ffd1fa 0%, #ffdfc8 100%);
        background: -webkit-linear-gradient(-45deg, #ffd1fa 0%, #ffdfc8 100%);
        background: linear-gradient(135deg, #ffd1fa 0%, #ffdfc8 100%);
        filter: progid:DXImageTransform.Microsoft.gradient(startColorstr='#ffd1fa', endColorstr='#ffdfc8', GradientType=1);
    }
</style>

<body>
    <div class="login-container">
        <h1 style="padding-top: 100px; font-size: 48px;">LOGIN</h1>
        <form action="/login" method="POST">
            <input type="text" class="login-input" required placeholder="ID" name="id">
            <input type="password" class="login-input" required placeholder="PW" style="margin-top: 30px;" name="pw"><br>
            <a href="/register" style="text-decoration: none; font-size: 25px;"><p>Sign up new account</p></a>
            <input type="submit" class="learn-more" style="margin-top: 100px;" value="Submit">
            <p style="color: red; font-size: 20px;"><%= err %></p>
        </form>
    </div>
</body>

</html>
